GEMINI_API_KEY=your-gemini-api-key-here
PORT=3001

# RAG Retrieval Tuning
# Number of chunks to fetch from Qdrant per query. Increase for complex multi-table questions.
RAG_TOP_K=15
# Minimum cosine similarity score to include a chunk (0–1). Lower = more results but noisier context.
RAG_SCORE_THRESHOLD=0.45
