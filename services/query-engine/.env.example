GEMINI_API_KEY=your-gemini-api-key-here
PORT=3001

# Multi-Database Configuration
# Option A: JSON registry
DB_REGISTRY='[{"dbId":"bykestores","displayName":"Byke Stores","connectionString":"Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=BykeStores;Uid=sa;Pwd=yourpassword;TrustServerCertificate=yes;"},{"dbId":"lpl_poc","displayName":"LPL POC","connectionString":"Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=LPL_POC;Uid=sa;Pwd=yourpassword;TrustServerCertificate=yes;"}]'

# Option B: Individual env vars (alternative to DB_REGISTRY)
# REGISTERED_DBS=bykestores,lpl_poc
# DB_DISPLAY_NAME_BYKESTORES=Byke Stores
# DB_CONNECTION_STRING_BYKESTORES=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=BykeStores;Uid=sa;Pwd=yourpassword;TrustServerCertificate=yes;
# DB_DISPLAY_NAME_LPL_POC=LPL POC
# DB_CONNECTION_STRING_LPL_POC=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=LPL_POC;Uid=sa;Pwd=yourpassword;TrustServerCertificate=yes;

# Backward compatibility fallback (used only when no registry is configured)
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=DefaultDatabase;Uid=sa;Pwd=yourpassword;TrustServerCertificate=yes;

# RAG Retrieval Tuning
# Number of chunks to fetch from Qdrant per query. Increase for complex multi-table questions.
RAG_TOP_K=15
# Minimum cosine similarity score to include a chunk (0–1). Lower = more results but noisier context.
RAG_SCORE_THRESHOLD=0.45

# Audit logging (automatically disabled when APP_ENV=prod, NODE_ENV=production, or PROD_ENV=true)
APP_ENV=dev
AUDIT_ENABLED=true
AUDIT_UI_ENABLED=true
AUDIT_INCLUDE_STACK=true
AUDIT_LOG_DIR=logs/dev
AUDIT_MAX_TEXT_LENGTH=3000